# Local AyurForm research uses the installed AyurParam model through Ollama.
# To use Mock explicitly for UI-only development, set both values to mock.
AYURSUTRA_LLM_MODE=ollama
LLM_PROVIDER=ollama
AYURSUTRA_LLM_MODEL=bharatgenai/AyurParam
AYURSUTRA_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=hf.co/A-Aryam/AyurParam-GGUF:Q4_K_M
# Compatibility timeout for existing non-Research-Assistant Ollama callers.
OLLAMA_TIMEOUT_SECONDS=180
# Research Assistant keeps connection establishment separate from model load/generation.
OLLAMA_CONNECT_TIMEOUT_SECONDS=10
OLLAMA_GENERATION_TIMEOUT_SECONDS=300
OLLAMA_TEMPERATURE=0.2
# Research Assistant budget: complete passages only, bounded by the character cap;
# Ollama's configured context window is larger than the answer-token allowance.
AYURSUTRA_RESEARCH_NUM_PREDICT=800
AYURSUTRA_RESEARCH_NUM_CTX=4096
AYURSUTRA_RESEARCH_CONTEXT_MAX_CHARS=6500
AYURSUTRA_TOP_K=5
AYURSUTRA_MAX_COSINE_DISTANCE=0.85
# This selects the isolated, non-production corpus for local evaluation only.
AYURSUTRA_KNOWLEDGE_MODE=development
# Local API configuration. Supply the signing secret through the environment;
# never commit an actual secret value.
AYURSUTRA_ENV=development
AYURSUTRA_AUTH_JWT_SECRET=
AYURSUTRA_AUTH_COOKIE_SECURE=0
AYURSUTRA_AUTH_ALLOWED_ORIGIN=http://localhost:8501
AYURSUTRA_AUTH_API_URL=http://localhost:8000
# Development-only cookie transport probe. Keep disabled outside local HTTP.
AYURSUTRA_ENABLE_DEV_COOKIE_TEST=0
AYURSUTRA_DEV_COOKIE_SECURE=0
# Optional: use auto device placement with accelerate after confirming adequate RAM/VRAM.
# AYURSUTRA_DEVICE_MAP=auto
POSTGRES_DB=ayurform
POSTGRES_USER=ayurform
POSTGRES_PASSWORD=<strong-local-or-production-password>
DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/ayurform
AYURFORM_ADMIN_EMAILS=reviewer@example.org
AYURFORM_API_URL=http://127.0.0.1:8002
# Optional explicit demo flag. If enabled, UI must label records synthetic.
AYURFORM_DEMO_MODE=0
# Development only, when PostgreSQL is intentionally unavailable:
# AYURFORM_DB_FALLBACK=sqlite
